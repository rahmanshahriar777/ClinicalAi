# ---------------------------------------------------------------------------
# Clinical AI Platform — environment variables
# Copy to .env (root) for local development. Never commit real secrets.
# Production: inject from AWS Secrets Manager / Azure Key Vault / GCP Secret Manager.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
MOBILE_DEEP_LINK=clinicalai://
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
LOG_LEVEL=debug
REQUEST_BODY_LIMIT=1mb

# Database
DATABASE_URL=postgresql://clinical:clinical@localhost:5432/clinical

# Redis / queues
REDIS_URL=redis://localhost:6379
# When true, AI and notification jobs run inline (no Redis). Use for tests / quick local runs.
JOBS_INLINE=false

# Object storage (S3-compatible; MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=clinical-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Auth
# AUTH_MODE=local : the API issues its own JWTs (argon2 passwords, refresh
#                   rotation, optional TOTP MFA). Suitable for dev/pilots.
# AUTH_MODE=oidc  : the API is an OAuth2/OIDC resource server; tokens are
#                   validated against AUTH_ISSUER's JWKS (Keycloak, Auth0,
#                   Cognito, Entra ID). Users must exist locally (JIT provisioning
#                   is controlled by AUTH_OIDC_JIT_PROVISION).
# ---------------------------------------------------------------------------
AUTH_MODE=local
AUTH_ISSUER=http://localhost:8080/realms/clinical
AUTH_CLIENT_ID=clinical-app
AUTH_AUDIENCE=clinical-api
AUTH_OIDC_JIT_PROVISION=false
# Local mode only. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-64-char-random-string-before-running-anything-real
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
MFA_ISSUER_NAME=Clinical AI Platform
# Encryption key for at-rest field encryption of MFA secrets (32 bytes base64). openssl rand -base64 32
FIELD_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# AI (blueprint §13, §16)
# AI_PROVIDER: mock | azure-openai | bedrock | openai-compatible
#   mock              deterministic, schema-valid outputs — default for dev/tests
#   azure-openai      Azure OpenAI (external; requires BAA + EXTERNAL_AI_ALLOWED=true)
#   bedrock           AWS Bedrock (Claude etc.; external unless private endpoint)
#   openai-compatible private/self-hosted (vLLM, Ollama, TGI) — Path B in §11.5
# ---------------------------------------------------------------------------
AI_PROVIDER=mock
AI_FALLBACK_PROVIDER=
AI_MODEL_PRIMARY=gpt-4o
AI_MODEL_LIGHT=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
AI_EMBEDDING_DEPLOYMENT=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=llama3.1
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=1

# PHI redaction: rules | presidio
PHI_REDACTOR=rules
PRESIDIO_ANALYZER_URL=http://localhost:5002
PRESIDIO_ANONYMIZER_URL=http://localhost:5001

# Safety (blueprint §11.5, §15)
ENABLE_PHI_REDACTION=true
# Hard gate: when false, only non-external providers (mock / openai-compatible) may be used.
EXTERNAL_AI_ALLOWED=false
# When true only CLINICIAN can approve AI drafts; when false NURSE may approve patient message drafts.
REQUIRE_CLINICIAN_APPROVAL=true

# Feature flags (environment defaults; DB flags override per organization)
FEATURE_PATIENT_MESSAGING=true
FEATURE_AI_NOTES=true
FEATURE_AI_MESSAGE_DRAFTS=true
FEATURE_SPEECH_TO_TEXT=false
FEATURE_PATIENT_EDUCATION=false

# Notifications
NOTIFY_EMAIL_PROVIDER=log
NOTIFY_PUSH_PROVIDER=log
NOTIFY_SMS_PROVIDER=log
EXPO_ACCESS_TOKEN=

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=clinical-api
SENTRY_DSN=

# Web / mobile clients
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
